generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model FiberRoute {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  route_name  String?
  fiber_type  String?
  core_count  String?
  marker_type String?
  geojson     Json
  created_at  DateTime @default(now()) @db.Timestamptz(6)

  @@map("fiber_routes")
}
